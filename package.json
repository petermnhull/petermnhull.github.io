{
  "name": "petermnhull.github.io",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "markdown-to-jsx": "^7.1.7",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.4.2",
    "react-scripts": "5.0.0"
  },
  "scripts": {
    "blog-index": "node scripts/build-blog-index.js",
    "prestart": "npm run blog-index",
    "start": "react-scripts start",
    "prebuild": "npm run blog-index",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "format": "prettier \"src/**/*.{ts,tsx,css}\" scripts --write"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "prettier": "^2.7.1",
    "typescript": "^4.9.5"
  }
}
